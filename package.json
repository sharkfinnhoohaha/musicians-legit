    "eval:run": "dotenv -e .env.local -- tsx eval/runner.ts",
    "experiment": "dotenv -e .env.local -- tsx scripts/run-experiment.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/react": "^2.0.0",
