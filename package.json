    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.0",
    "@vercel/blob": "^0.27.0",
    "ai": "^6.0.168",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.469.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
